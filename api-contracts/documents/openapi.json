 must be Base64 encoded.","operationId":"createDocumentSet","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateDocumentSetRequest"}}},"required":true},"responses":{"201":{"description":"Document set created successfully","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentSetResponse"}}}},"400":{"description":"Invalid request data","content":{"application/json":{"schema":{"type":"object","$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Schema not found","content":{"application/json":{"schema":{"type":"object","$ref":"#/components/schemas/ApiError"}}}}}}},"/api/document-sets/{setId}/documents":{"post":{"tags":["Document Sets"],"summary":"Add a document to a set","description":"Adds a new document to an existing document set. Content must be Base64 encoded.","operationId":"addDocument","parameters":[{"name":"setId","in":"path","description":"Document set UUID","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddDocumentRequest"}}},"required":true},"responses":{"201":{"description":"Document added successfully","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"400":{"description":"Invalid request data","content":{"application/json":{"schema":{"type":"object","$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Document set or schema not found","content":{"application/json":{"schema":{"type":"object","$ref":"#/components/schemas/ApiError"}}}}}}},"/api/document-sets/{setId}/documents/{docId}/versions":{"post":{"tags":["Document Sets"],"summary":"Add a document version","description":"Adds a new version to an existing document. Content must be Base64 encoded.","operationId":"addDocumentVersion","parameters":[{"name":"setId","in":"path","description":"Document set UUID","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"docId","in":"path","description":"Document UUID","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddVersionRequest"}}},"required":true},"responses":{"201":{"description":"Version added successfully","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DocumentVersionResponse"}}}},"400":{"description":"Invalid request data","content":{"application/json":{"schema":{"type":"object","$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Document set or document not found","content":{"application/json":{"schema":{"type":"object","$ref":"#/components/schemas/ApiError"}}}}}}},"/api/document-sets/{setId}/documents/{docId}/versions/{versionNumber}/validate":{"post":{"tags":["Document Sets"],"summary":"Validate a document version","description":"Validates a document version against its schema. Returns 200 if valid, 422 if invalid.","operationId":"validateDocumentVersion","parameters":[{"name":"setId","in":"path","description":"Document set UUID","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"docId","in":"path","description":"Document UUID","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"versionNumber","in":"path","description":"Version number (1-based)","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"Document is valid","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ValidationResultResponse"}}}},"422":{"description":"Document is invalid","content":{"application/json":{"schema":{"type":"object","$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Document set, document, or version not found","content":{"application/json":{"schema":{"type":"object","$ref":"#/components/schemas/ApiError"}}}}}}},"/api/document-sets/{setId}/documents/{docId}/derivatives":{"get":{"tags":["Document Sets"],"summary":"Get all derivatives","description":"Retrieves all derivatives for a document","operationId":"