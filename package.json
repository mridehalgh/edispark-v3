{
  "name": "edispark-workspace",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "node tooling/scripts/dev.mjs",
    "dev:api": "node tooling/scripts/dev-api.mjs",
    "dev:web": "node tooling/scripts/dev-web.mjs",
    "dev:mft-api": "pnpm dev:api",
    "dev:integration-api": "pnpm dev:api",
    "dev:as2-simulator": "node tooling/scripts/dev-as2-simulator.mjs",
    "mft:lab:certs": "node tooling/scripts/generate-as2-lab-certs.mjs",
    "local:reset": "node tooling/scripts/reset-local.mjs",
    "contracts:export:api": "./mvnw -B -pl apps/edispark-api -am -Popenapi-export verify -DskipTests",
    "contracts:export:documents": "pnpm contracts:export:api",
    "contracts:generate:documents": "pnpm --filter @edispark/documents-client generate",
    "contracts:sync:documents": "pnpm contracts:export:documents && pnpm contracts:generate:documents",
    "contracts:export:mft": "pnpm contracts:export:api",
    "contracts:generate:mft": "pnpm --filter @edispark/mft-client generate",
    "contracts:sync:mft": "pnpm contracts:export:mft && pnpm contracts:generate:mft",
    "contracts:export:integration": "pnpm contracts:export:api",
    "contracts:generate:integration": "pnpm --filter @edispark/integration-client generate",
    "contracts:sync:integration": "pnpm contracts:export:integration && pnpm contracts:generate:integration",
    "contracts:generate": "pnpm -r --workspace-concurrency=3 --filter '@edispark/*-client' run generate",
    "contracts:validate": "node --test tooling/scripts/openapi-contract-validation.test.mjs && node tooling/scripts/check-openapi-contracts.mjs",
    "contracts:typecheck": "pnpm -r --workspace-concurrency=3 --filter '@edispark/*-client' run typecheck",
    "contracts:check": "pnpm contracts:validate && pnpm contracts:generate && pnpm contracts:typecheck && node tooling/scripts/check-generated-contracts.mjs",
    "test:tooling": "node --test tooling/scripts/*.test.mjs",
    "check": "pnpm test:tooling && ./mvnw -B test && pnpm --filter @edispark/web test && pnpm --filter @edispark/web typecheck && pnpm --filter @edispark/web build && pnpm contracts:check"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "3.1094.0",
    "@aws-sdk/client-codeartifact": "3.1094.0",
    "@aws-sdk/client-kms": "3.1094.0",
    "@aws-sdk/client-s3": "3.1094.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "esbuild": "0.28.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@xmldom/xmldom@0.8": "0.8.15",
      "js-yaml@^4": "4.3.2",
      "js-yaml@^3": "3.15.2",
      "nanoid@^3": "3.3.18",
      "source-map-js": "1.2.2"
    }
  }
}
