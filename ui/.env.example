BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Hostname only. Defaults to the hostname in BETTER_AUTH_URL.
BETTER_AUTH_PASSKEY_RP_ID=localhost
# Comma-separated browser origins allowed to create and use passkeys.
BETTER_AUTH_PASSKEY_ORIGINS=http://localhost:3000
BETTER_AUTH_DATABASE_PATH=auth.db
RESEND_API_KEY=
EMAIL_FROM="EDI Spark <auth@example.com>"
BETTER_AUTH_TRUSTED_ORIGINS=

# Production JWT signing (AWS KMS). Local development uses a local ES256 keypair.
# The JWKS document must contain the public key matching BETTER_AUTH_JWT_KID.
BETTER_AUTH_JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
BETTER_AUTH_JWT_KID=
BETTER_AUTH_JWT_KMS_KEY_ID=
AWS_REGION=eu-west-2
# Server-only URL for the Spring Documents API. Never expose this with NEXT_PUBLIC_.
DOCUMENTS_API_URL=http://localhost:8080
